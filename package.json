{
  "name": "campusbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant REST API for schools: courses, enrollments, payments, and campus-system integrations.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @campusbridge/api",
    "build": "npm run build --workspaces --if-present",
    "generate": "npm run generate -w @campusbridge/api",
    "db:setup": "npm run db:setup -w @campusbridge/api",
    "db:seed": "npm run db:seed -w @campusbridge/api",
    "db:reset": "npm run db:reset -w @campusbridge/api",
    "tenant:create": "npm run tenant:create -w @campusbridge/api --",
    "lint": "eslint . --max-warnings=0 --cache --cache-location .cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run --project api-unit",
    "test:integration": "vitest run --project api-integration",
    "test:watch": "vitest",
    "infra:up": "docker compose up -d --wait && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "protobufjs": false,
    "ssh2": false
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
