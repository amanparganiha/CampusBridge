{
  "name": "@campusbridge/api",
  "version": "0.1.0",
  "private": true,
  "description": "CampusBridge REST API and background worker.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env scripts/db-bootstrap.ts",
    "db:setup": "npm run db:migrate && npm run db:bootstrap",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:bootstrap && npm run db:seed",
    "tenant:create": "tsx --env-file-if-exists=../../.env scripts/create-tenant.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "0.16.1",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "openapi-types": "12.1.3",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.2.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "oauth2-mock-server": "9.2.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0"
  }
}
