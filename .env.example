# CampusBridge local development configuration.
# Copy to `.env` (git-ignored). The same file feeds docker compose (ports) and the Node apps.
# Every value is validated at boot by apps/api/src/config/env.ts.

# --- Runtime -------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
ADMIN_URL=http://localhost:5173
TRUST_PROXY=false
CORS_ORIGINS=

# --- PostgreSQL ----------------------------------------------------------------------------
# Published on 5433 so it does not collide with other local Postgres instances.
POSTGRES_PORT=5433
# Table owner: migrations and role bootstrap only.
MIGRATE_DATABASE_URL=postgresql://campusbridge:campusbridge@localhost:5433/campusbridge
# Runtime role: DML only, row-level security enforced.
DATABASE_URL=postgresql://cb_app:cb_app_dev_password@localhost:5433/campusbridge
# Cross-tenant role: worker outbox relay and scanners only.
SYSTEM_DATABASE_URL=postgresql://cb_system:cb_system_dev_password@localhost:5433/campusbridge
DB_POOL_MAX=10

# --- Redis ---------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Observability -------------------------------------------------------------------------
METRICS_TOKEN=dev-metrics-token-change-me

# --- Local infrastructure ports (docker compose) -------------------------------------------
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
KEYCLOAK_PORT=8080
